# --- Required paths (host-side; remap inside docker via docker-compose.yml) ---
OUTPUT_DIR=./output
TEMP_DIR=./temp
DOWNLOADS_DIR=./Downloads
CONTEXT_DIR=./context

# --- Config files ---
DISCORD_MAPPING_FILE=./discord_speaker_mapping.json
WHISPER_PROMPT_FILE=./prompts/whisper.txt
SUMMARY_PROMPT_FILE=./prompts/summary.txt
DETAILS_PROMPT_FILE=./prompts/details.txt
QUOTES_PROMPT_FILE=./prompts/quotes.txt
TEMPLATE_FILE=./template.md

# --- Gemini ---
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_PRO_MODEL="gemini-3.1-pro-preview"
GEMINI_FLASH_MODEL="gemini-3-flash-preview"

# --- Whisper (faster-whisper / CTranslate2) ---
# Model size: tiny, base, small, medium, large-v2, large-v3, distil-large-v3 …
WHISPER_MODEL=large-v3
# Device: "cuda" works on both NVIDIA CUDA and AMD ROCm (CT2 keeps the name on ROCm).
# Use "cpu" to force CPU.
WHISPER_DEVICE=cuda
# Compute type: float16 (GPU default), int8_float16, int8 (CPU default).
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=pl
# Where faster-whisper caches downloaded CT2 models.
WHISPER_CACHE_DIR=./models
# VAD pre-filtering (silence skip) — generally improves quality.
WHISPER_VAD=true
