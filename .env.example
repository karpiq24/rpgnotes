# --- Required paths (host-side; remap inside docker via docker-compose.yml) ---
OUTPUT_DIR=./output
TEMP_DIR=./temp
DOWNLOADS_DIR=./Downloads
# Campaign context: entity wiki pages + Campaign_Context.md/Timeline.md.
# Recommended: point this directly at an OotD checkout's `content/` dir
# (e.g. ../OotD/content) instead of copying/syncing context into rpgnotes —
# its layout (02-People/, 03-Locations/, 04-Items-and-Loot/, 05-Lore/,
# Campaign_Context.md, Timeline.md) matches what rpgnotes expects exactly,
# so campaign state never drifts between the two repos.
CONTEXT_DIR=../OotD/content

# --- Config files ---
DISCORD_MAPPING_FILE=./discord_speaker_mapping.json
# Whisper hotwords (names prepended to every decode window; see the file header).
WHISPER_PROMPT_FILE=./prompts/whisper.txt
SUMMARY_PROMPT_FILE=./prompts/summary.txt
QUOTES_PROMPT_FILE=./prompts/quotes.txt
TEMPLATE_FILE=./template.md

# --- Summary prompt parts (chunked map-reduce summarizer) ---
STYLE_RULES_FILE=./prompts/style_rules.txt
ANTI_HALLUCINATION_FILE=./prompts/anti_hallucination.txt
VALIDATION_PROMPT_FILE=./prompts/validation.txt
# ASR-error knowledge base embedded into each chunk's glossary.
# Degrades gracefully if the file is missing.
PHONETIC_CORRECTIONS_FILE=../OotD/.agents/skills/rpg-summarizer/resources/phonetic_corrections.md

# --- Summarization tuning ---
# Transcript chunk size in lines (chunks break only at speaker turns).
SUMMARY_CHUNK_LINES=800
# Temperature for the factual per-chunk summaries.
# Empty = model default. Google recommends the default (1.0) for Gemini 3+;
# lower values can cause looping or degraded reasoning.
SUMMARY_TEMPERATURE=
# Optional final prose-polish pass (changes no facts/names/order). Off by
# default: OotD's refine pass rewrites the prose anyway, and this full-draft
# rewrite is the most output-heavy Argon call.
SUMMARY_POLISH_PASS=false
SUMMARY_POLISH_TEMPERATURE=
# Only the last N `## Sesja` sections of Timeline.md are sent as AI context
# (the whole file grows unbounded). 0 = send the full timeline.
TIMELINE_RECENT_SESSIONS=10

# --- Session screenshots (optional visual context) ---
# Directory with shot_<unix_ts>.png frames + session_start.txt produced by
# scripts/capture_session.py. Unset/empty (default) disables the feature —
# the pipeline then runs exactly as before. Typically:
# SCREENSHOTS_DIR=./temp/screenshots (the capture script's default output;
# clearing temp at startup keeps this folder)
SCREENSHOTS_DIR=
# Multimodal model for screenshot captioning. Empty = GEMINI_FLASH_MODEL.
VISUAL_CAPTION_MODEL=
# Re-dedupe near-identical frames during ingestion (the capture script already
# dedupes on capture; this catches frames captured with different settings).
VISUAL_DEDUPE=true
# Polish captioning prompt for the multimodal calls.
VISUAL_CAPTION_PROMPT_FILE=./prompts/visual_caption.txt
# Frames are downscaled to this long-edge size and re-encoded as JPEG for the
# caption upload only — originals on disk stay full-res PNG. 0 sends originals.
VISUAL_UPLOAD_MAX_DIM=1536
VISUAL_UPLOAD_JPEG_QUALITY=80
# ImageMagick crop geometry (WxH+X+Y) applied before the AI upload and the
# dedupe signature — cuts system/browser chrome (dock, tabs, clock) out of
# what the caption model sees. Empty = no crop. Originals stay untouched.
# Find the values once: crop a test frame with `magick shot.png -crop WxH+X+Y
# +repage out.png` and eyeball it.
VISUAL_CROP=

# --- Screenshot capture (scripts/capture_session.py) ---
# Monitor by connector name (DP-1) or EDID model substring (e.g. LG). Empty =
# pick interactively.
CAPTURE_MONITOR=
# Sub-region of that monitor to keep, WxH+X+Y in the monitor's own pixels —
# e.g. only the Foundry page inside a maximized browser. Empty = whole monitor.
CAPTURE_CROP=

# --- Gemini ---
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_PRO_MODEL="gemini-4-argon"
GEMINI_FLASH_MODEL="gemini-3.8-flash"
# Thinking level for the summary/polish/validation calls: low | medium | high.
# Empty = model default (medium on gemini-4-argon). Thinking is billed as output.
GEMINI_THINKING_LEVEL=
# flex = half price, requests may queue for minutes (falls back to standard
# when Flex is at capacity). standard = full price, immediate.
GEMINI_SERVICE_TIER=flex
# Validate -> auto-fix rounds (each one re-reads the whole transcript).
VALIDATION_MAX_PASSES=1

# --- Whisper (faster-whisper / CTranslate2) ---
# Model size: tiny, base, small, medium, large-v2, large-v3, distil-large-v3 …
WHISPER_MODEL=large-v3
# Device: "cuda" works on both NVIDIA CUDA and AMD ROCm (CT2 keeps the name on ROCm).
# Use "cpu" to force CPU.
WHISPER_DEVICE=cuda
# Compute type: float16 (GPU default), int8_float16, int8 (CPU default).
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=pl
# Where faster-whisper caches downloaded CT2 models.
WHISPER_CACHE_DIR=./models
# VAD pre-filtering (silence skip) — generally improves quality.
WHISPER_VAD=true
# Names linked in the last N Timeline.md sessions are added to the Whisper
# hotwords after the ones in WHISPER_PROMPT_FILE (0 = file only).
WHISPER_HOTWORDS_RECENT_SESSIONS=3
